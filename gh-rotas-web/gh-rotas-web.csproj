<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>gh_rotas_web</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp\node_modules\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="ClientApp\**" />
  </ItemGroup>
  <Target Name="BuildReact" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="ClientApp" Command="npm ci" Condition="!Exists('ClientApp/node_modules/.package-lock.json')" />
    <Exec WorkingDirectory="ClientApp" Command="npm run build" />
    <!-- Refresh the items after Vite changes the hashed filenames. -->
    <ItemGroup>
      <Content Remove="wwwroot\app\**" />
      <Content Include="wwwroot\app\**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
